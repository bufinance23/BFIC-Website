<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BFIC — Baylor Finance & Investment Club</title>
<meta name="description" content="The Baylor Finance & Investment Club develops the next generation of finance professionals through technical training, industry exposure, and a tight-knit professional community.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bu-green: #154734;
    --bu-green-dark: #0a2418;
    --bu-gold: #FFB81C;
    --bg: #fafaf7;
    --bg-alt: #f2f0ea;
    --ink: #14181b;
    --ink-soft: #2a2f33;
    --muted: rgba(20, 24, 27, 0.62);
    --muted-light: rgba(20, 24, 27, 0.42);
    --rule: rgba(20, 24, 27, 0.12);
    --rule-strong: rgba(20, 24, 27, 0.28);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    font-weight: 400;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  a { color: inherit; }

  /* ============ NAV ============ */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 247, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    padding: 18px 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    height: 36px;
  }
  .nav-logo img {
    height: 100%;
    width: auto;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 9px 16px;
    letter-spacing: 0.005em;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 16px;
    right: 16px;
    height: 2px;
    background: var(--bu-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .nav-links a:not(.nav-cta):hover::after { transform: scaleX(1); }
  .nav-cta {
    background: var(--bu-green);
    color: var(--bg) !important;
    margin-left: 16px;
    padding: 11px 22px !important;
    font-weight: 500 !important;
    transition: background 0.2s;
    border-bottom: 2px solid var(--bu-gold) !important;
  }
  .nav-cta:hover { background: var(--bu-green-dark); }

  /* ============ HERO ============ */
  .hero {
    padding: 0;
    border-bottom: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
    min-height: 88vh;
    display: flex;
    align-items: center;
  }
  /* Background image */
  .hero-bg {
    position: absolute;
    inset: 0;
    background: url('data:image/png;base64,') center center / cover no-repeat;
    z-index: 0;
  }
  /* Light wash so text stays readable */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(250,250,247,0.94) 0%,
      rgba(250,250,247,0.88) 45%,
      rgba(250,250,247,0.55) 75%,
      rgba(250,250,247,0.20) 100%
    );
  }
  .hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
    padding: 140px 56px 120px;
  }
  .hero-left {
    max-width: 680px;
  }
  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bu-green);
    font-weight: 500;
    margin-bottom: 36px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--bu-gold);
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: clamp(3.5rem, 8vw, 8rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--ink);
    max-width: 16ch;
    padding-bottom: 0.08em;
  }
  h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--bu-green);
  }
  .hero-sub {
    margin-top: 48px;
    max-width: 580px;
    font-size: 1.18rem;
    line-height: 1.55;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .hero-cta {
    margin-top: 56px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 28px;
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }
  .btn-primary {
    background: var(--bu-green);
    color: var(--bg);
    border-bottom: 2px solid var(--bu-gold);
  }
  .btn-primary:hover { background: var(--bu-green-dark); }
  .btn-arrow::after {
    content: '→';
    font-size: 1rem;
    transition: transform 0.2s;
  }
  .btn-arrow:hover::after { transform: translateX(4px); }
  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
  }
  .btn-secondary:hover {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  @media (max-width: 980px) {
    .hero-inner { padding: 80px 24px; }
    .hero-left { max-width: 100%; }
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        rgba(250,250,247,0.96) 0%,
        rgba(250,250,247,0.92) 60%,
        rgba(250,250,247,0.75) 100%
      );
    }
  }

  /* ============ KEY STATS ============ */
  .stats {
    padding: 80px 56px;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-alt);
  }
  .stats-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 56px;
  }
  .stat {
    border-top: 2px solid var(--bu-gold);
    padding-top: 28px;
    position: relative;
  }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
    color: var(--bu-green);
    letter-spacing: -0.02em;
    padding-bottom: 0.04em;
  }
  .stat-label {
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ============ MISSION ============ */
  .mission {
    padding: 140px 56px;
    border-bottom: 1px solid var(--rule);
  }
  .mission-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
  }
  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.92rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bu-green);
    font-weight: 600;
    padding-top: 22px;
    align-self: start;
    position: sticky;
    top: 100px;
    display: inline-block;
    background-image: linear-gradient(to right, var(--bu-gold) 0, var(--bu-gold) 48px, var(--bu-green) 48px, var(--bu-green) 100%);
    background-size: 100% 3px;
    background-repeat: no-repeat;
    background-position: top left;
  }
  .section-label-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .section-label-row .roman {
    color: var(--muted);
    font-size: 0.62rem;
    margin-top: 2px;
  }

  .mission-body p {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.4;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .mission-body p + p { margin-top: 28px; }
  .mission-body em { font-style: italic; color: var(--bu-green); }

  /* ============ PILLARS ============ */
  .pillars {
    padding: 140px 56px;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-alt);
  }
  .pillars-inner {
    max-width: 1320px;
    margin: 0 auto;
  }
  .pillars-header {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    margin-bottom: 80px;
    align-items: end;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 5.2vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 18ch;
    padding-bottom: 0.12em;
  }
  h2 em { font-style: italic; color: var(--bu-green); font-weight: 300; }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--rule-strong);
    border: 1px solid var(--rule-strong);
  }
  .pillar {
    background: var(--bg-alt);
    padding: 56px 48px;
    transition: background 0.3s;
    position: relative;
  }
  .pillar:hover { background: var(--bg); }
  .pillar-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--bu-gold);
    letter-spacing: 0.2em;
    margin-bottom: 28px;
    font-weight: 600;
    display: inline-block;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--bu-gold);
  }
  .pillar h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 18px;
  }
  .pillar p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.65;
    max-width: 42ch;
  }

  /* ============ FEATURE / DEEP DIVE ============ */
  .feature {
    padding: 140px 56px;
    border-bottom: 1px solid var(--rule);
  }
  .feature-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
  }
  .feature-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .feature-block {
    border-top: 1px solid var(--rule);
    padding-top: 32px;
  }
  .feature-block h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .feature-block p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.65;
  }
  .feature-block .meta {
    margin-top: 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ============ COMMUNITY QUOTE ============ */
  .community {
    padding: 160px 56px;
    border-bottom: 1px solid var(--rule);
    background: var(--bu-green);
    color: var(--bg);
    position: relative;
    overflow: hidden;
  }
  .community-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: left;
    position: relative;
  }
  .community .section-label {
    color: var(--bu-gold);
    background-image: linear-gradient(to right, var(--bg) 0, var(--bg) 48px, var(--bu-gold) 48px, var(--bu-gold) 100%);
    position: static;
    margin-bottom: 32px;
  }
  .community blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3.6vw, 3rem);
    line-height: 1.32;
    font-weight: 300;
    letter-spacing: -0.015em;
    margin-top: 48px;
    color: var(--bg);
    padding-bottom: 0.1em;
  }
  .community blockquote em {
    font-style: italic;
    color: var(--bu-gold);
  }
  .community-attr {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid rgba(250, 250, 247, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.7);
  }

  /* Decorative bull silhouette */
  .community-bg-mark {
    position: absolute;
    right: -120px;
    bottom: -80px;
    width: 600px;
    opacity: 0.04;
    pointer-events: none;
  }

  /* ============ PLACEMENTS ============ */
  .placements {
    padding: 140px 56px;
    border-bottom: 1px solid var(--rule);
  }
  .placements-inner {
    max-width: 1320px;
    margin: 0 auto;
  }
  .placements-header {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    margin-bottom: 64px;
  }
  .placements-intro p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin-top: 24px;
  }
  .firms {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .firm {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 32px 28px;
    transition: all 0.2s;
    cursor: default;
    position: relative;
  }
  .firm::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--bu-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s;
  }
  .firm:hover { background: var(--bg-alt); }
  .firm:hover::before { transform: scaleY(1); }
  .firm-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .firm-city {
    margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ============ JOIN ============ */
  .join {
    padding: 160px 56px;
    background: var(--ink);
    color: var(--bg);
    position: relative;
    overflow: hidden;
  }
  .join-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    position: relative;
  }
  .join .section-label {
    color: var(--bu-gold);
    background-image: linear-gradient(to right, var(--bg) 0, var(--bg) 48px, var(--bu-gold) 48px, var(--bu-gold) 100%);
    position: static;
    margin-bottom: 32px;
  }
  .join h2 {
    color: var(--bg);
    margin-top: 32px;
  }
  .join h2 em { color: var(--bu-gold); }
  .join p {
    margin-top: 32px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(250, 250, 247, 0.75);
    max-width: 48ch;
  }

  .contact-card {
    background: rgba(250, 250, 247, 0.04);
    border: 1px solid rgba(255, 184, 28, 0.2);
    border-top: 3px solid var(--bu-gold);
    padding: 48px;
  }
  .contact-card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bu-gold);
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 184, 28, 0.2);
  }
  .contact-row {
    margin-bottom: 28px;
  }
  .contact-row:last-child { margin-bottom: 0; }
  .contact-row .key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.55);
    margin-bottom: 8px;
  }
  .contact-row .val {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--bg);
    word-break: break-word;
  }
  .contact-row .val a {
    color: var(--bg);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 184, 28, 0.4);
    transition: border-color 0.2s;
  }
  .contact-row .val a:hover { border-color: var(--bu-gold); }

  /* ============ FOOTER ============ */
  footer {
    background: var(--bu-green-dark);
    color: var(--bg);
    padding: 72px 56px 32px;
  }
  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 64px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(250, 250, 247, 0.15);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .footer-brand .nav-logo { height: 40px; }
  .footer-brand p {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.5;
    color: rgba(250, 250, 247, 0.7);
    max-width: 36ch;
  }
  .footer-col h4 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bu-gold);
    margin-bottom: 22px;
    font-weight: 500;
  }
  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 12px; }
  .footer-col a {
    color: rgba(250, 250, 247, 0.7);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--bu-gold); }
  .footer-bottom {
    max-width: 1320px;
    margin: 0 auto;
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: rgba(250, 250, 247, 0.45);
  }

  /* ============ SCROLL REVEAL ============ */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* Staggered children inside a revealed parent */
  .stats-inner .reveal:nth-child(1) { transition-delay: 0s; }
  .stats-inner .reveal:nth-child(2) { transition-delay: 0.1s; }
  .stats-inner .reveal:nth-child(3) { transition-delay: 0.2s; }
  .stats-inner .reveal:nth-child(4) { transition-delay: 0.3s; }

  .pillars-grid .reveal:nth-child(1) { transition-delay: 0s; }
  .pillars-grid .reveal:nth-child(2) { transition-delay: 0.12s; }
  .pillars-grid .reveal:nth-child(3) { transition-delay: 0.24s; }
  .pillars-grid .reveal:nth-child(4) { transition-delay: 0.36s; }

  .firms .reveal:nth-child(1) { transition-delay: 0s; }
  .firms .reveal:nth-child(2) { transition-delay: 0.08s; }
  .firms .reveal:nth-child(3) { transition-delay: 0.16s; }
  .firms .reveal:nth-child(4) { transition-delay: 0.24s; }
  .firms .reveal:nth-child(5) { transition-delay: 0.32s; }

  /* hero entrance */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .eyebrow { animation: fadeUp 0.9s 0.05s both; }
  h1 { animation: fadeUp 0.9s 0.2s both; }
  .hero-sub { animation: fadeUp 0.9s 0.4s both; }
  .hero-cta { animation: fadeUp 0.9s 0.6s both; }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 980px) {
    nav { padding: 16px 24px; }
    .nav-links li:not(:last-child) { display: none; }
    .hero-inner { padding: 80px 24px; }
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        rgba(250,250,247,0.96) 0%,
        rgba(250,250,247,0.92) 60%,
        rgba(250,250,247,0.75) 100%
      );
    }
    .stats-inner { grid-template-columns: 1fr 1fr; gap: 40px; }
    .mission-inner, .pillars-header, .placements-header { grid-template-columns: 1fr; gap: 32px; }
    .section-label { position: static; }
    .pillars-grid { grid-template-columns: 1fr; }
    .firms { grid-template-columns: repeat(3, 1fr); }
    .join-inner { grid-template-columns: 1fr; gap: 48px; }
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 40px; }
